    {
     "name": "sting",
     "at": 5.1,
     "gain": -5
    }
   ]
  },
  {
   "id": "b003",
   "text": "Cuentan que baja de la sierra con sus mulas. Un hombrecito de negro, con un sombrero que le tapa la cara.",
   "pause": 0.3,
   "music": "mystery",
   "amb": [
