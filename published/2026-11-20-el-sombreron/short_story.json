     "gain": -7
    }
   ]
  },
  {
   "id": "b006",
   "text": "Su madre encendió un cerillo. Sobre la almohada, un sombrero inmenso. Y debajo del ala… dos ojos como brasas.",
   "pause": 0.35,
   "music": "dread",
   "sfx": [
