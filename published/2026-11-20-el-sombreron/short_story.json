     "args": {
      "dur": 5,
      "distance": 0.6
     }
    }
   ]
  },
  {
   "id": "b004",
   "text": "Inés tenía el cabello hasta las rodillas. Una mañana, las mulas amanecieron amarradas a su casa.",
   "pause": 0.3,
   "sfx": [
    {
     "name": "knock",
