  {
   "id": "b002",
   "text": "Cuentan que en la vieja Ciudad de México vivía Beatriz: la joven más hermosa de la Nueva España.",
   "pause": 0.3,
   "music": "mystery",
   "amb": [
    "night",
    "crickets"
   ]
  },
  {
   "id": "b003",
   "text": "Hasta que llegó don Martín, un marqués que no soportaba que nadie más la mirara.",
   "pause": 0.3,
   "music": "tension"
  },
  {
   "id": "b004",
   "text": "Ningún hombre volverá a pararse bajo tu balcón, Beatriz.",
