   ]
  },
  {
   "id": "b002",
   "text": "Las tres de la mañana. Te asomas al huerto del convento. Debajo del viejo durazno hay una monja… inmóvil. Levanta la cara… y no tiene ojos.",
   "pause": 0.3,
   "sfx": [
    {
     "name": "bell",
