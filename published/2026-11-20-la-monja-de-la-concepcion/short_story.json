     "at": 10.3,
     "gain": -3
    }
   ]
  },
  {
   "id": "b003",
   "text": "Cuentan que hacia mil quinientos sesenta, María de Ávila se enamoró de Arrutia, un muchacho sin fortuna.",
   "pause": 0.3,
   "music": "mystery",
   "amb": [
    "night",
    "wind"
   ],
   "sfx": [
    {
     "name": "boom",
     "at": 0.0,
     "gain": -8
    }
   ]
  },
  {
   "id": "b004",
   "text": "Sus hermanos le ofrecieron una bolsa de oro. Y Arrutia… la tomó.",
   "pause": 0.3,
   "sfx": [
    {
     "name": "coins",
     "at": 1.8,
     "gain": -8
    }
   ]
  },
  {
   "id": "b005",
   "text": "A María la encerraron en el convento. Cada tarde esperaba debajo del durazno, mirando hacia la puerta.",
   "pause": 0.3,
   "music": "sad",
   "sfx": [
    {
     "name": "door",
     "at": 1.0,
     "gain": -9
    }
   ]
  },
  {
   "id": "b006",
   "text": "Una mañana la encontraron al pie del árbol. Sin vida. Y desde entonces, de noche, la ven ahí. Esperando.",
   "pause": 0.3,
   "music": "tension",
   "sfx": [
    {
     "name": "boom",
