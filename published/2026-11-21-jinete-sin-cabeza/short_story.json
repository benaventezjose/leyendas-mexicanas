     "gain": -3
    }
   ]
  },
  {
   "id": "b003",
   "text": "Cuentan que se llamaba Vidal. Un vaquero de la tierra de nadie, entre el Nueces y el Bravo, que se reía de los rinches.",
   "pause": 0.3,
   "music": "mystery",
   "amb": [
