     }
    },
    {
     "name": "sting",
     "at": 6.0,
     "gain": -4
    }
   ]
  },
  {
   "id": "b006",
   "text": "La tercera noche, la vela se apagó. Un roce de pelo áspero. Y la mano… lo toma de la muñeca.",
   "pause": 0.2,
   "music": "dread",
   "sfx": [
    {
