    }
   ]
  },
  {
   "id": "b002",
   "text": "Medianoche. Detrás de ti suenan unos pasos… que no son de persona. Son pezuñas.",
   "pause": 0.3,
   "sfx": [
    {
     "name": "footsteps",
     "at": 1.3,
     "gain": -12,
