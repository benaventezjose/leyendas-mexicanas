   ]
  },
  {
   "id": "b002",
   "text": "Cuentan que en el sur de Yucatán, un abuelo hizo con barro virgen un alux para cuidar su milpa.",
   "pause": 0.35,
   "music": "mystery"
  },
  {
   "id": "b003",
   "text": "Solo pedía su jícara de sacab. Y una regla: nunca olvidarlo.",
   "pause": 0.35
  },
  {
   "id": "b004",
   "text": "Pero el nieto, Eusebio, se fue siete años… y lo olvidó.",
   "pause": 0.35,
   "music": "tension"
  },
  {
   "id": "b005",
   "text": "Al volver, empezaron las piedritas. Huellitas del tamaño de un dedo. Y el maíz, mordido con dientes pequeñitos.",
   "pause": 0.35,
   "sfx": [
    {
     "name": "whisper",
     "at": 3.0,
     "gain": -10,
     "args": {
      "dur": 3
     }
    }
   ]
  },
  {
   "id": "b006",
   "text": "Eusebio le disparó. Y una noche, la hamaca de su hijo estaba vacía.",
   "pause": 0.3,
   "music": "dread",
   "sfx": [
    {
     "name": "boom",
     "at": 0.15,
     "gain": -3
    },
    {
     "name": "riser",
     "at": 2.0,
     "gain": -9,
     "args": {
      "dur": 3.0
     }
    }
   ]
  },
  {
   "id": "b007",
   "text": "Ven a jugar conmigo.",
   "voice": "ef_dora",
   "speed": 0.85,
   "fx": "eco",
   "pause": 0.15,
   "sfx": [
    {
     "name": "sting",
