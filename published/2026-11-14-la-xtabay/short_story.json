     "at": 3.9,
     "gain": -3
    }
   ]
  },
  {
   "id": "b005",
   "text": "Lorenzo, ven conmigo.",
   "voice": "ef_dora",
   "speed": 0.8,
   "fx": "eco",
   "pause": 0.1
  },
  {
   "id": "b006",
   "text": "Nadie en ese monte sabía su nombre. La siguió toda la noche… y volvieron a la misma ceiba.",
   "pause": 0.35,
